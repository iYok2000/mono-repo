# ================================
# Docker Compose Environment Variables
# ================================
# Copy this file to .env and update with your values:
# cp .env.example .env

# ================================
# PostgreSQL Configuration
# ================================
POSTGRES_DB=devtoolkit
POSTGRES_USER=devuser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ================================
# Backend Go Configuration
# ================================
GIN_MODE=debug

# Server selection
ENABLE_HTTP=true
ENABLE_GRPC=false

# Server Ports
HTTP_PORT=8080
GRPC_PORT=50051

# Service Info
SERVICE_NAME=backend-go
ENVIRONMENT=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
# For development, allow multiple origins. For production, specify only your frontend domain
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://web:3000,http://127.0.0.1:3000

# Database Configuration
# Note: DB_HOST should be "postgres" for Docker, "localhost" for local development
DATABASE_URL=postgres://devuser:your_secure_password_here@postgres:5432/devtoolkit?sslmode=disable
DB_USERNAME=devuser
DB_PASSWORD=your_secure_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devtoolkit

# ================================
# Next.js Web Configuration
# ================================
NEXT_PUBLIC_GO_API_URL=http://localhost:8080
NEXT_PUBLIC_GO_HEALTH_URL=http://localhost:8080/health

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your-bucket-name

# JWT Secrets (use strong random strings in production)
JWT_SECRET=your_jwt_secret_min_32_chars
REFRESH_SECRET=your_refresh_secret_min_32_chars
